# ============================================
# Configuración de Base de Datos - Supabase
# ============================================

# URL JDBC de conexión a PostgreSQL
# Formato: jdbc:postgresql://[host]:[port]/[database]
# Supabase proporciona una URL similar a:
# jdbc:postgresql://db.XXXXXX.supabase.co:5432/postgres
DB_URL=jdbc:postgresql://db.XXXXXX.supabase.co:5432/postgres

# Usuario de PostgreSQL
# Por defecto en Supabase: postgres
DB_USERNAME=postgres

# Contraseña de PostgreSQL
# Esta es la contraseña que configuraste al crear el proyecto Supabase
DB_PASSWORD=your_secure_password_here

# Driver de PostgreSQL (no modificar)
DB_DRIVER=org.postgresql.Driver

# ============================================
# Configuración de Aplicación
# ============================================

# Puerto en el que corre la aplicación
SERVER_PORT=8080

# Nivel de logging
LOGGING_LEVEL=INFO

# ============================================
# Docker Compose (entorno local / despliegue simulado)
# ============================================
# Copia este archivo a .env y define al menos POSTGRES_PASSWORD.
# NUNCA subas el .env al repositorio (está en .gitignore).
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=cambia_esta_clave

# Número de réplicas del microservicio detrás del gateway
APP_REPLICAS=2

# Puerto del host donde se publica el gateway (Nginx)
GATEWAY_PORT=8080

# Imagen a desplegar. Por defecto se construye localmente;
# en el pipeline se usa la imagen publicada en GHCR, por ejemplo:
# APP_IMAGE=ghcr.io/<usuario>/<repositorio>:sha-abc1234
APP_IMAGE=pokemon-service:local
DEPLOY_ENV=local
